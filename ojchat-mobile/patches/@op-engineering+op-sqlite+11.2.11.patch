 project(OPSQLite)
 cmake_minimum_required(VERSION 3.9.0)
 
+# The C++ sources use C++17 features (std::variant, if constexpr,
+# std::is_same_v, [[maybe_unused]]). React Native 0.73's prefab modules do
+# not propagate a C++ standard to this target, so the NDK toolchain default
+# (C++14) is used and the build fails with "no template named 'variant'".
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_CXX_EXTENSIONS OFF)
+
 set (PACKAGE_NAME "op-sqlite")
 
 include_directories(
