# Public (client-side) environment variables.
# These are inlined into the JS bundle at build time by react-native-dotenv,
# so never put secrets here.
#
# Copy this file to `.env` and fill in the values.

# Local dev server (used when the device can reach your machine over the LAN)
PUBLIC_LOCAL_API_URL=http://YOUR_LAN_IP:3000/v1
PUBLIC_LOCAL_WS_URL=http://YOUR_LAN_IP:3000

# Public server (used on mobile data — fill in when deployed)
PUBLIC_API_URL=
PUBLIC_WS_URL=
